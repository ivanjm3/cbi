          "category": {"type": "categorical", "description": "Product category"},
          "revenue": {"type": "numeric", "unit": "currency", "description": "Total revenue for the period"},
          "orders": {"type": "numeric", "unit": "count", "description": "Number of orders placed"},
          "avg_order_value": {"type": "numeric", "unit": "currency", "description": "Average value per order"},
          "return_rate": {"type": "numeric", "unit": "percentage", "description": "Percentage of orders returned"}
        },
        "filter_keywords": ["quarter", "region", "category", "revenue", "orders", "return", "returns", "average order"]
      },
      "relationships": []
    },
