        "filter_keywords": ["department", "job_level", "level", "office_location", "location", "remote", "in-office", "onsite", "on-site", "salary", "bonus", "utilization", "training", "certifications", "engagement", "hire_date", "hired", "employee", "employees", "workforce", "staff", "headcount"]
