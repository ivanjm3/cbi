    {
      "concept_id": "ontology:workforce_metrics",
      "label": "Workforce Metrics",
      "properties": {
        "domain": "hr",
        "data_source": "redshift",
        "agent_id": "redshift-spoke-agent",
        "description": "Employee workforce data including department, job level, salary, bonus, utilization, training, certifications, engagement scores, office location, and remote/in-office work status",
        "table_name": "workforce_metrics",
        "row_count": 120,
        "aggregatable": true,
        "columns": {
          "employee_id": {"type": "identifier", "sql_type": "VARCHAR", "description": "Unique employee identifier"},
          "employee_name": {"type": "categorical", "sql_type": "VARCHAR", "description": "Full name of the employee"},
          "department": {"type": "categorical", "sql_type": "VARCHAR", "description": "Department (Engineering, Product, Design, Data Science, DevOps, QA, Security)"},
          "job_level": {"type": "categorical", "sql_type": "VARCHAR", "description": "Job level (Junior, Mid, Senior, Staff, Principal, Lead, Director)"},
          "hire_date": {"type": "categorical", "sql_type": "DATE", "description": "Date the employee was hired"},
          "office_location": {"type": "categorical", "sql_type": "VARCHAR", "description": "Office location (San Francisco, New York, London, Berlin, Toronto, Sydney)"},
          "base_salary": {"type": "numeric", "sql_type": "DECIMAL", "unit": "currency", "description": "Annual base salary"},
          "bonus_pct": {"type": "numeric", "sql_type": "DECIMAL", "unit": "percentage", "description": "Bonus percentage"},
          "utilization_rate": {"type": "numeric", "sql_type": "DECIMAL", "unit": "percentage", "description": "Utilization rate"},
          "training_hours": {"type": "numeric", "sql_type": "INTEGER", "unit": "hours", "description": "Training hours completed"},
          "certifications": {"type": "numeric", "sql_type": "INTEGER", "unit": "count", "description": "Number of certifications held"},
          "engagement_score": {"type": "numeric", "sql_type": "DECIMAL", "unit": "score", "description": "Employee engagement score (2.5-5.0)"},
          "is_remote": {"type": "categorical", "sql_type": "BOOLEAN", "description": "Whether the employee works remotely (true) or in-office (false)"}
