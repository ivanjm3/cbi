    {
      "concept_id": "ontology:support_tickets",
      "label": "Support Tickets",
      "properties": {
        "domain": "customer_support",
        "data_source": "redshift",
        "agent_id": "redshift-spoke-agent",
        "description": "Customer support ticket data with resolution times, satisfaction ratings, escalation status, and first-contact resolution by customer tier, channel, priority, issue category, and assigned team",
        "table_name": "support_tickets",
        "row_count": 200,
        "aggregatable": true,
        "columns": {
          "ticket_id": {"type": "identifier", "sql_type": "VARCHAR", "description": "Unique ticket identifier"},
          "created_date": {"type": "categorical", "sql_type": "DATE", "description": "Date the ticket was created"},
          "resolved_date": {"type": "categorical", "sql_type": "DATE", "description": "Date the ticket was resolved (NULL if unresolved)"},
          "customer_tier": {"type": "categorical", "sql_type": "VARCHAR", "description": "Customer tier (Free, Starter, Professional, Enterprise, Strategic)"},
          "channel": {"type": "categorical", "sql_type": "VARCHAR", "description": "Support channel (Email, Chat, Phone, Self-Service Portal, Social Media)"},
          "priority": {"type": "categorical", "sql_type": "VARCHAR", "description": "Ticket priority (Low, Medium, High, Critical)"},
          "issue_category": {"type": "categorical", "sql_type": "VARCHAR", "description": "Issue category (Login/Authentication, Billing Dispute, Feature Request, Performance Issue, Data Export, Integration Error, Account Management, API Failure, Onboarding Help, Downtime Report)"},
          "assigned_team": {"type": "categorical", "sql_type": "VARCHAR", "description": "Assigned support team (Tier 1, Tier 2, Tier 3 Engineering, Billing Team, Account Management)"},
          "resolution_hours": {"type": "numeric", "sql_type": "DECIMAL", "unit": "hours", "description": "Hours to resolve the ticket"},
          "satisfaction_rating": {"type": "numeric", "sql_type": "INTEGER", "unit": "score", "description": "Customer satisfaction rating (1-5)"},
          "escalated": {"type": "categorical", "sql_type": "BOOLEAN", "description": "Whether the ticket was escalated (true/false)"},
          "first_contact_resolution": {"type": "categorical", "sql_type": "BOOLEAN", "description": "Whether resolved on first contact (true/false)"}
        },
        "filter_keywords": ["customer_tier", "tier", "channel", "priority", "issue_category", "category", "issue", "assigned_team", "team", "escalated", "escalation", "first_contact", "first contact resolution", "fcr", "resolution", "resolved", "unresolved", "satisfaction", "rating", "ticket", "tickets", "support"]
      },
      "relationships": []
    },
