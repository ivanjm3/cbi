      "concept_id": "ontology:sales_revenue",
      "label": "Sales Revenue",
      "properties": {
        "domain": "finance",
        "unit": "currency",
        "aggregatable": true,
        "description": "Revenue generated from product sales, tracked quarterly by region and category",
        "data_source": "financial_data",
        "agent_id": "spoke-agent-json",
        "table_name": "sales_performance",
